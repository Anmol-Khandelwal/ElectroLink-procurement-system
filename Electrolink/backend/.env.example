# =========================================================
# ELECTROLINK BACKEND ENVIRONMENT
#
# Copy this file to ".env" and fill in your own values.
# The real .env file is ignored by git and must never be
# committed.
# =========================================================

PORT=5000

# ---------------------------------------------------------
# POSTGRESQL
# ---------------------------------------------------------

DB_USER=postgres
DB_HOST=localhost
DB_NAME=electrolink
DB_PASSWORD=your_database_password
DB_PORT=5432

# ---------------------------------------------------------
# AUTHENTICATION
#
# Any long random string. Changing it signs every user out.
# ---------------------------------------------------------

JWT_SECRET=replace_this_with_a_long_random_secret

# ---------------------------------------------------------
# FRONTEND ORIGIN(S)
#
# Comma separated list allowed to call the API.
# ---------------------------------------------------------

CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------
# ADMINISTRATOR ACCOUNT
#
# Created automatically when the server starts. If the email
# already belongs to an account, that account is promoted to
# administrator instead.
#
# ADMIN_EMAILS is an optional comma separated list of other
# existing accounts that should also become administrators.
# ---------------------------------------------------------

ADMIN_EMAIL=admin@electrolink.com
ADMIN_PASSWORD=admin123
ADMIN_EMAILS=
